# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only configuration. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=replace-with-a-long-random-secret
FEED_FETCH_CONTACT=admin@example.com

# Keep cloud writes disabled until migrations and RLS tests pass.
CLOUD_LEARNING_ENABLED=false
RSS_READING_ENABLED=false
# Enable append-only server evidence only in the isolated Web Beta deployment.
NEXT_PUBLIC_BETA_EVIDENCE_ENABLED=0

# ROOTLINE_E2E_FIXTURES is for non-production automated tests only. Never set it in Beta/production.
# Set CLOUD_LEARNING_ENABLED=true only after the migration/RLS gate and approved deployment cutover.

# In Supabase Auth settings, enable Confirm Email and allow:
# http://localhost:3000/auth/callback
